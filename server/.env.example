# Copy to server/.env (or set these in your host's dashboard). Never commit real values.
# The server also reads the project-root .env, so NEON_DB placed there works for local development.

NODE_ENV=production
PORT=4000

# PostgreSQL connection string (Neon: Dashboard → Connection details → pooled connection).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Postgres schema for the tables. Created automatically on start.
DB_SCHEMA=wedding_gifts
DB_POOL_MAX=10
DB_POOL_MIN=4

# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_HOURS=12

# Only needed if the site calls the API from a different origin (not needed with the /api rewrite).
CORS_ORIGINS=
# How many reverse proxies sit in front of the API (for correct client IPs in rate limiting).
TRUST_PROXY=1
# Where uploaded images are stored. Use a persistent disk/volume in production.
UPLOAD_DIR=uploads

# Rate limits per IP per 15 minutes
RATE_RESERVE=10
RATE_LOGIN=8
RATE_CONTRIBUTE=10

# Razorpay. Leave the key id/secret empty to run "Our Dreams" in clearly labelled demo mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MIN_CONTRIBUTION=100
MAX_CONTRIBUTION=500000

# Used by `npm run seed` / `npm run create-couple`
WEDDING_SLUG=alica-rushil
WEDDING_COUPLE=Alica & Rushil
WEDDING_DATE=2027-02-13T10:30:00+05:30
COUPLE_EMAIL=
COUPLE_PASSWORD=
