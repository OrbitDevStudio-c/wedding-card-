{
  "name": "wedding-gifts-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Gift registry, reservations, dreams and couple dashboard API for the wedding invitation",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file-if-exists=../.env --env-file-if-exists=.env src/index.js",
    "seed": "node --env-file-if-exists=../.env --env-file-if-exists=.env scripts/seed.js",
    "create-couple": "node --env-file-if-exists=../.env --env-file-if-exists=.env scripts/create-couple.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "sharp": "^0.33.5"
  }
}
