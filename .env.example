# Public URL of the deployed site. Used for Open Graph / WhatsApp previews and the share link.
VITE_SITE_URL=https://alica-weds-rushil.vercel.app

# Where RSVPs are sent. Leave empty for demo mode (the form shows success without sending).
# Formspree:         https://formspree.io/f/xxxxxxxx
# Google Apps Script: https://script.google.com/macros/s/XXXXXXXX/exec
VITE_RSVP_ENDPOINT=

# Wedding Gifts (see README → Wedding Gifts). The slug must match the wedding created by `npm run seed`.
VITE_WEDDING_SLUG=alica-rushil
# Set to false to remove the gifts section, /gifts and the dashboard link entirely.
VITE_GIFTS_ENABLED=true
